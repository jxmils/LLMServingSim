# Ignore env file
env/

# Ignore python cache
*.pyc
__pycache__/
*.joblib

# Ignore pkl files
*.pkl

# Ignore bench results
bench/results/

# Local ARC / installer caches
.venv/
.venv-vllm/
.arc-cache/
.uv-cache/

# Ignore scratch simulation output. The committed example runs under
# outputs/example_*.csv stay tracked; everything else in outputs/ is
# per-run scratch. ASTRA-Sim regenerates its inputs on every run, and
# --no-cleanup-inputs can leave gigabytes of them behind.
outputs/*
!outputs/example_*.csv
astra-sim/inputs/runs/

# AI agent cache files
.claude/
.codex/
.cursor/
.copilot/
.aider*
.continue/

# Local environments and generated files
.venv-sim/
LLMServingSim/
logs/
compile_htsim.log
ns3_hang_bt.txt
profiler/perf/H100/
